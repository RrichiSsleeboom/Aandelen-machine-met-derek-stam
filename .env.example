# Gmail instellingen
# Gebruik een Gmail App-wachtwoord (niet je normale wachtwoord)
# Stap 1: Ga naar https://myaccount.google.com/security
# Stap 2: Zet 2-staps verificatie aan
# Stap 3: Zoek op "App-wachtwoorden" en maak een nieuw wachtwoord aan voor "Mail"
GMAIL_USER=jouw.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Ontvanger van de koop-signalen (mag hetzelfde zijn als GMAIL_USER)
NOTIFY_EMAIL=jouw.email@gmail.com

# Telegram Bot instellingen (voor The Global Market Sentinel)
# Stap 1: Maak een bot aan via @BotFather op Telegram
# Stap 2: Stuur een bericht naar je bot
# Stap 3: Haal je chat ID op via: https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_BOT_TOKEN=1234567890:AABBccDDeeFfGgHhIiJjKkLlMmNnOoPpQqRr
TELEGRAM_CHAT_ID=-1001234567890
